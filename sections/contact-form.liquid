<div class="bg-gray-100 px-4 py-16 sm:px-6 lg:px-8">

  <div class="mx-auto max-w-2xl rounded-2xl bg-white p-6 shadow-lg sm:p-10">

    <!-- Header -->
    <div class="mb-8 text-center">

      <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        Contact Us
      </h1>

      <p class="mt-3 text-base leading-7 text-gray-600">
        Have a question or need help?
        Send us a message and we'll get back to you soon.
      </p>

    </div>


    {% form 'contact' %}

      <!-- Success Message -->
      {% if form.posted_successfully? %}

        <div class="mb-6 rounded-lg border border-green-200 bg-green-50 p-4 text-sm text-green-700">
          Thank you! Your message has been sent successfully.
        </div>

      {% endif %}


      <!-- Form Errors -->
      {% if form.errors %}

        <div class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
          {{ form.errors | default_errors }}
        </div>

      {% endif %}


      <!-- Name -->
      <div class="mb-5">

        <label
          for="ContactFormName"
          class="mb-2 block text-sm font-semibold text-gray-800"
        >
          Name
        </label>

        <input
          type="text"
          id="ContactFormName"
          name="contact[name]"
          placeholder="Your Name"
          required
          class="block w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-gray-900 focus:ring-2 focus:ring-gray-200"
        >

      </div>


      <!-- Email -->
      <div class="mb-5">

        <label
          for="ContactFormEmail"
          class="mb-2 block text-sm font-semibold text-gray-800"
        >
          Email
        </label>

        <input
          type="email"
          id="ContactFormEmail"
          name="contact[email]"
          placeholder="Your Email"
          required
          class="block w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-gray-900 focus:ring-2 focus:ring-gray-200"
        >

      </div>


      <!-- Phone Number -->
      {% if section.settings.show_phone_number %}

        <div class="mb-5">

          <label
            for="ContactFormPhone"
            class="mb-2 block text-sm font-semibold text-gray-800"
          >
            Phone Number
          </label>

          <input
            type="tel"
            id="ContactFormPhone"
            name="contact[phone]"
            placeholder="Your Phone Number"
            class="block w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-gray-900 focus:ring-2 focus:ring-gray-200"
          >

        </div>

      {% endif %}


      <!-- Message -->
      <div class="mb-6">

        <label
          for="ContactFormMessage"
          class="mb-2 block text-sm font-semibold text-gray-800"
        >
          Message
        </label>

        <textarea
          id="ContactFormMessage"
          name="contact[body]"
          placeholder="Your Message"
          rows="6"
          required
          class="block w-full resize-y rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-gray-900 focus:ring-2 focus:ring-gray-200"
        ></textarea>

      </div>


      <!-- Submit Button -->
      <button
        type="submit"
        class="w-full rounded-lg bg-gray-900 px-6 py-3.5 text-sm font-semibold text-white transition duration-200 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2"
      >
        Send Message
      </button>

    {% endform %}

  </div>

</div>


{% schema %}

{
  "name": "Contact Form",
  "tag": "section",

  "settings": [
    {
      "type": "checkbox",
      "id": "show_phone_number",
      "label": "Show Phone Number",
      "default": false
    }
  ],

  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}

{% endschema %}