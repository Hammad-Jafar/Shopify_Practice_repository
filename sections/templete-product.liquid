{% assign selected_product = section.settings.product %}

{% if selected_product %}
  <h1>{{ selected_product.title }}</h1>

  <p>Media count: {{ selected_product.media.size }}</p>

  {% for media in selected_product.media %}
    {% render 'product-media', media: media %}
  {% endfor %}

{% else %}
  <p>Please select a product.</p>
{% endif %}


{% schema %}
{
  "name": "Templete Product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Select product"
    }
  ],
  "presets": [
    {
      "name": "Templete Product"
    }
  ]
}
{% endschema %}