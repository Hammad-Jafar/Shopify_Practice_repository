{%- paginate collection.products by section.settings.products_per_page -%}
  {%- for product in collection.products -%}
    {%- if product.featured_image -%}
      {% render 'product-cart', product: product %}
    {%- else -%}
      <p>No products available.</p>
    {%- endif -%}
  {%- endfor -%}

  {{- paginate | default_pagination -}}
{%- endpaginate -%}

{% schema %}
{
  "name": "Paginate Collection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Happy"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Discover our latest collection"
    },
    {
      "type": "number",
      "id": "products_per_page",
      "label": "Products per page",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Paginate Collection"
    }
  ]
}
{% endschema %}
