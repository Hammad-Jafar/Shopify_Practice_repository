<div class="max-w-6xl mx-auto px-4 py-10">

  <div class="mb-8">
    <h1 class="text-3xl font-bold">My Orders</h1>
    <p class="text-gray-500 mt-2">
      View your previous orders and their details.
    </p>
  </div>

  {% if customer.orders.size > 0 %}

    <div class="overflow-x-auto bg-white rounded-xl shadow border">

      <table class="w-full text-left">

        <thead class="bg-gray-100">
          <tr>
            <th class="px-6 py-4">Order</th>
            <th class="px-6 py-4">Date</th>
            <th class="px-6 py-4">Payment</th>
            <th class="px-6 py-4">Fulfillment</th>
            <th class="px-6 py-4">Total</th>
            <th class="px-6 py-4"></th>
          </tr>
        </thead>

        <tbody>

          {% for order in customer.orders %}

            <tr class="border-t">

              <td class="px-6 py-5 font-semibold">
                {{ order.name }}
              </td>

              <td class="px-6 py-5 text-gray-600">
                {{ order.created_at | date: "%B %d, %Y" }}
              </td>

              <td class="px-6 py-5">
                {{ order.financial_status_label }}
              </td>

              <td class="px-6 py-5">
                {{ order.fulfillment_status_label | default: "Unfulfilled" }}
              </td>

              <td class="px-6 py-5 font-semibold">
                {{ order.total_price | money }}
              </td>

              <td class="px-6 py-5">

                <a
                  href="{{ order.customer_url }}"
                  class="inline-block bg-black text-white px-4 py-2 rounded-lg hover:bg-gray-800"
                >
                  View
                </a>

              </td>

            </tr>

          {% endfor %}

        </tbody>

      </table>

    </div>

  {% else %}

    <div class="text-center border rounded-xl p-12">

      <h2 class="text-2xl font-semibold">
        No orders yet
      </h2>

      <p class="text-gray-500 mt-2 mb-6">
        You haven't placed any orders yet.
      </p>

      <a
        href="{{ routes.all_products_collection_url }}"
        class="inline-block bg-black text-white px-6 py-3 rounded-lg"
      >
        Start Shopping
      </a>

    </div>

  {% endif %}

</div>