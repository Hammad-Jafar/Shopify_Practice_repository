<div class="bg-white border-b shadow-sm">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <div class="flex-1">
        <a href="{{ routes.root_url }}" class="text-2xl font-bold">
          {{ shop.name }}
        </a>
      </div>

      <div class="-mr-2 -my-2 ml-3 md:hidden">
        <button type="button" class="bg-white p-2 inline-flex items-center justify-center focus:outline-none">
          {% render 'hamburger-icon' %}
        </button>
      </div>

      <!-- Navigation -->
      <nav class="hidden md:flex items-center space-x-8">
        {% for link in section.settings.menu.links %}
          {% if link.links.size > 0 %}
            <div
              class="relative"
              x-data="{ open: false }"
              @mouseenter="open = true"
              @mouseleave="open = false"
            >
              <button
                type="button"
                class="flex items-center font-medium text-gray-700 hover:text-black"
              >
                {{ link.title }}

                <svg
                  class="ml-1 w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </button>

              <!-- Dropdown -->
              <div
                x-show="open"
                x-transition
                x-cloak
                class="absolute left-0 mt-2 w-56 bg-white border rounded-lg shadow-lg z-50"
              >
                {% for child in link.links %}
                  <a
                    href="{{ child.url }}"
                    class="block px-4 py-3 hover:bg-gray-100"
                  >
                    {{ child.title }}
                  </a>
                {% endfor %}
              </div>
            </div>

          {% else %}
            <a
              href="{{ link.url }}"
              class="font-medium text-gray-700 hover:text-black"
            >
              {{ link.title }}
            </a>
          {% endif %}
        {% endfor %}
      </nav>

      <!-- Right Side -->
      <div class="flex items-center gap-6">
        <a href="{{ routes.cart_url }}" class="relative">
          {% render 'icon-shopping-bag' %}

          {% if cart.item_count > 0 %}
            <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">
              {{ cart.item_count }}
            </span>
          {% endif %}
        </a>

        {% if shop.customer_accounts_enabled %}
          {% if customer %}
            <a
              href="{{ routes.account_url }}"
              class="font-medium hover:text-blue-600"
            >
              Account
            </a>
          {% else %}
            <a
              href="{{ routes.account_login_url }}"
              class="font-medium hover:text-blue-600"
            >
              Login
            </a>

            <a
              href="{{ routes.account_register_url }}"
              class="font-medium hover:text-blue-600"
            >
              Register
            </a>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    }
  ],
  "presets": [
    {
      "name": "Custom Header"
    }
  ]
}
{% endschema %}


