{% case media.media_type %}

  {% when 'image' %}
    <img
      src="{{ media | image_url: width: 800 }}"
      alt="{{ media.alt | escape }}"
      width="{{ media.width }}"
      height="{{ media.height }}"
      class="w-full h-auto object-cover rounded-lg"
    >

  {% when 'video' %}
    {{ media | video_tag: controls: true }}

  {% when 'external_video' %}
    {{ media | external_video_tag }}

  {% when 'model' %}
    {{ media | model_viewer_tag }}

{% endcase %}